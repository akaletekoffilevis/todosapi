@host = http://localhost:5252
@contentType = application/json

### 1. Register a new user
# @name register
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "username": "testuser",
  "password": "Test@1234"
}

### 2. Login and get JWT token
# @name login
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{
  "username": "testuser",
  "password": "Test@1234"
}

### 3. Get all tasks
# Requires a valid token from login
@token = {{login.response.body.$.token}}
GET {{host}}/api/tasks
Authorization: Bearer {{token}}
Accept: {{contentType}}

### 4. Create a task
POST {{host}}/api/tasks
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "title": "My First Task",
  "description": "This is a test task"
}

### 5. Get task by ID
GET {{host}}/api/tasks/1
Authorization: Bearer {{token}}
Accept: {{contentType}}

### 6. Update a task
PUT {{host}}/api/tasks/1
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "title": "Updated Task",
  "description": "Updated description",
  "isCompleted": false
}

### 7. Mark task as completed
PATCH {{host}}/api/tasks/1/complete?value=true
Authorization: Bearer {{token}}

### 8. Mark task as not completed
PATCH {{host}}/api/tasks/1/complete?value=false
Authorization: Bearer {{token}}

### 9. Delete a task
DELETE {{host}}/api/tasks/1
Authorization: Bearer {{token}}

### 10. Test invalid token
GET {{host}}/api/tasks
Authorization: Bearer invalid_token_here
